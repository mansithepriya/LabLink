# Port for Cloud Run / Container runtime (defaults to 8080)
PORT=8080

# Node environment mode
NODE_ENV=production

# Google Gemini API Configuration (Official @google/genai SDK)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Google Calendar OAuth 2.0 & Bidirectional Synchronization
# ==============================================================================
# Google Cloud Console OAuth 2.0 Client Credentials (Web Application)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Exact registered OAuth redirect URI (Matches Google Cloud Console Authorized Redirect URIs)
# In development: http://localhost:8080/api/calendar/oauth/callback
# In Cloud Run: https://<your-service>-<hash>.a.run.app/api/calendar/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/oauth/callback

# Master Encryption Key for AES-256-GCM token encryption at rest (32+ bytes or random hex)
# Generate with: openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY=your_32_byte_aes_256_gcm_encryption_key_here

# Secret used to HMAC-sign OAuth states to prevent CSRF hijacking
OAUTH_STATE_SECRET=your_random_oauth_state_signing_secret_here

# Optional Durable Storage Backend (vault | firestore | postgres)
# Default is encrypted durable vault. On Cloud Run, set to firestore or configure DATABASE_URL.
STORAGE_BACKEND=vault
