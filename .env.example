# Port for Cloud Run / Container runtime (defaults to 8080)
PORT=8080

# Node environment mode
NODE_ENV=production

# Google Gemini API Configuration (Official @google/genai SDK)
# When set, LabLink uses Google Gemini with strict catalogue grounding.
# When unset or on network/quota failure, LabLink seamlessly operates using the
# institutional deterministic rule engine with zero disruption.
# GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (Defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
